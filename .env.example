# Raven Labs Form Tests - Environment Configuration
# Copy this file to .env and fill in your values

# SMTP Configuration (for email reports)
# Gmail setup: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Report Email Configuration
REPORT_EMAIL=creative@ravenlabs.com.au

# Website Configuration
WEBSITE_URL=https://www.theravenlabs.com

# Optional: Test Configuration
# NODE_ENV=production
# CI=false
# PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers
